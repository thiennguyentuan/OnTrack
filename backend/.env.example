DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ontrack
JWT_SECRET=ontrack-demo-secret
API_PORT=8000
# Required to deliver password reset links in non-local environments.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=mailer@example.com
SMTP_PASSWORD=replace-me
SMTP_FROM=mailer@example.com
APP_RESET_URL=http://localhost:8081/reset-password
# Local end-to-end testing with `docker compose up -d mailpit`:
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_STARTTLS=false
# SMTP_FROM=no-reply@ontrack.local
