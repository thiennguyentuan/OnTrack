{
  "expo": {
    "name": "OnTrack",
    "slug": "ontrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "ontrack",
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.ontrack.app"
    },
    "ios": {
      "bundleIdentifier": "com.ontrack.app"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0058be"
    }
  }
}
